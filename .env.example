# Copy to .env and fill in. Never commit .env.
# Nuxt maps NUXT_* variables onto runtimeConfig at runtime
# (NUXT_PUBLIC_SITE_URL -> runtimeConfig.public.siteUrl).

# Canonical public URL, no trailing slash. Used for canonical, hreflang and Open Graph.
# Local: http://localhost:3000 | Production: https://your-domain.com
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# GA4 measurement ID (build time). Leave empty to disable analytics.
# Set to the site measurement ID in the production build environment.
NUXT_PUBLIC_GA4_ID=

# Node server bind (production on the VPS, behind the reverse proxy).
# Keep the host on 127.0.0.1 so only the proxy can reach the app.
NITRO_HOST=127.0.0.1
NITRO_PORT=3000
